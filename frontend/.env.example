# Set this to point the dashboard at a real backend. Leave unset/empty to
# keep using the static JSON files in frontend/public/data/ (default, no
# backend required).
#
# Example once the Java + WEKA backend (see docs/api/openapi.yaml) is running:
# VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=
